          "id": "5dc9a173-05ae-4bcc-a11c-deda4676d15d",
          "name": "Export events for a specific user",
          "request": {
            "name": "Export events for a specific user",
            "description": {
              "content": "Exports all tracked events for a specific user identified by email address. Returns events in JSON format with support for pagination and filtering by event type.",
