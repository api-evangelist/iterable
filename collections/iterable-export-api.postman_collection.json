      "name": "Export",
      "description": {
        "content": "Endpoints for exporting data from Iterable projects in CSV and JSON formats. Supports exporting user events, message engagement data, and campaign metrics.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "89c5f4e8-78c6-441a-bc6a-8cf2f850a2dd",
          "name": "Export data as JSON",
          "request": {
            "name": "Export data as JSON",
            "description": {
              "content": "Exports event data from the Iterable project in JSON format. Supports filtering by date range and data type. The response is a stream of newline-delimited JSON objects, each representing a single event record.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "export",
                "data.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dataTypeName",
                  "value": "<string>",
                  "description": "(Required) The type of data to export. Supported types include emailSend, emailOpen, emailClick, emailUnSubscribe, emailBounce, emailComplaint, pushSend, pushBounce, pushOpen, smsSend, smsBounce, smsReceived, inAppSend, inAppOpen, inAppClick, webPushSend, purchase, customEvent, and hostedUnsubscribeClick."
                },
                {
                  "disabled": false,
                  "key": "startDateTime",
                  "value": "<dateTime>",
                  "description": "Start of the export date range in ISO 8601 format (e.g., 2024-01-01T00:00:00Z)"
                },
                {
                  "disabled": false,
                  "key": "endDateTime",
                  "value": "<dateTime>",
                  "description": "End of the export date range in ISO 8601 format (e.g., 2024-01-31T23:59:59Z)"
                },
                {
                  "disabled": false,
                  "key": "range",
                  "value": "<string>",
                  "description": "Predefined date range to export. Use instead of startDateTime and endDateTime for convenience. Options include Today, Yesterday, BeforeToday, and All."
