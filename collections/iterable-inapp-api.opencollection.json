{
  "opencollection": "1.0.0",
  "info": {
    "name": "Iterable Export Campaigns InApp API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Api-Key",
      "value": "{{Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "InApp",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get in-app messages for a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.iterable.com/api/inApp/getMessages",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Email address of the user"
              },
              {
                "name": "userId",
                "value": "",
                "type": "query",
                "description": "UserId of the user"
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Maximum number of messages to return"
              },
              {
                "name": "platform",
                "value": "",
                "type": "query",
                "description": "The platform to get messages for"
              }
            ]
          },
          "docs": "Retrieves pending in-app messages for a user, typically called by mobile or web SDKs to display in-app content."
        }
      ]
    }
  ],
  "bundled": true
}