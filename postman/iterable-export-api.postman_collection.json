                "header": [
                  {
                    "key": "Accept",
                    "value": "application/x-ndjson"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/export/data.json?dataTypeName=emailSend&startDateTime=<dateTime>&endDateTime=<dateTime>&range=All&omitFields=<string>&onlyFields=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "export",
                    "data.json"
                  ],
                  "query": [
                    {
                      "description": "(Required) The type of data to export. Supported types include emailSend, emailOpen, emailClick, emailUnSubscribe, emailBounce, emailComplaint, pushSend, pushBounce, pushOpen, smsSend, smsBounce, smsReceived, inAppSend, inAppOpen, inAppClick, webPushSend, purchase, customEvent, and hostedUnsubscribeClick.",
                      "key": "dataTypeName",
                      "value": "emailSend"
                    },
                    {
                      "description": "Start of the export date range in ISO 8601 format (e.g., 2024-01-01T00:00:00Z)",
                      "key": "startDateTime",
                      "value": "<dateTime>"
                    },
                    {
                      "description": "End of the export date range in ISO 8601 format (e.g., 2024-01-31T23:59:59Z)",
                      "key": "endDateTime",
                      "value": "<dateTime>"
                    },
                    {
                      "description": "Predefined date range to export. Use instead of startDateTime and endDateTime for convenience. Options include Today, Yesterday, BeforeToday, and All.",
                      "key": "range",
                      "value": "All"
                    },
                    {
                      "description": "Comma-separated list of fields to exclude from the export",
                      "key": "omitFields",
                      "value": "<string>"
                    },
                    {
                      "description": "Comma-separated list of fields to include in the export. When specified, only these fields are returned.",
                      "key": "onlyFields",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Exports event data from the Iterable project in JSON format. Supports filtering by date range and data type. The response is a stream of newline-delimited JSON objects, each representing a single event record."
