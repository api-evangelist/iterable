          "name": "userEvents",
          "item": [
            {
              "name": "Export events for a specific user",
              "id": "3a476a86-ee82-43ae-9295-23a3390a1827",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/export/userEvents?email=<email>&includeCustomEvents=true",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "export",
                    "userEvents"
                  ],
                  "query": [
                    {
                      "description": "(Required) Email address of the user whose events to export",
                      "key": "email",
                      "value": "<email>"
                    },
                    {
                      "description": "Whether to include custom events in the export",
                      "key": "includeCustomEvents",
                      "value": "true"
                    }
                  ]
                },
                "description": "Exports all tracked events for a specific user identified by email address. Returns events in JSON format with support for pagination and filtering by event type."
